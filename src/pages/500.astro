---
import MainLayout from "@/layouts/mainLayout.astro";
import '@/styles/global.css';

import { buttonVariants } from "@/components/ui/button";
---

<MainLayout>
    <div class="pt-20 text-center pb-10">
        <h1 class="font-link" style="font-size: 120pt;">500</h1>
        <h1 class="font-display mt-10 mb-2">Something's gone wrong.</h1>
        <p class="mt-2">Whoops! An error has occured somewhere, and this page can't be loaded.</p>
        <p>Sorry about all this. Please report the error to me and I'll get it fixed...</p>

        <a
            href="/"
            class={buttonVariants({  }) + " bg-white btn mt-2"}
        >
            Return Home
        </a>
        <a
            href="/contact"
            class={buttonVariants({ variant: 'outline' }) + " white border-white bg-transparent btn mt-2 mx-2"}
        >
            Contact Me
        </a>
    </div>
</MainLayout>