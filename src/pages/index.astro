---
import { IconMapPin, IconBriefcase, IconArrowNarrowUp, IconArrowNarrowRight, IconArrowNarrowLeft } from "@tabler/icons-react";
import MainLayout from "../layouts/mainLayout.astro";
import './src/styles/global.css';

import GradientSection from "@/components/ui/gradientSection.astro";
import MediaBox from "@/components/ui/mediaBox.astro";
import ProfilePhoto from "@/components/ui/profilePhoto.astro";
import ProjectCard from "@/components/ui/projectCard.astro";

import { Button } from "@/components/ui/button";
import { Link } from "@/components/ui/link";

const projects = [
	{
		title: "Wildlife & Woolly Art",
		desc: "I setup the shop and website for a Suffolk artist.",
		coverImage: "https://wildlifeandwoollyart.co.uk/images/artwork/painted_hare.webp",
		link: "https://wildlifeandwoollyart.co.uk",
		article: "/projects/wildlifeandwoollyart"
	},
	{
		title: "Wildlife & Woolly Art",
		desc: "I setup the shop and website for a Suffolk artist.",
		coverImage: "https://wildlifeandwoollyart.co.uk/images/artwork/painted_hare.webp",
		link: "https://wildlifeandwoollyart.co.uk",
		article: "/projects/wildlifeandwoollyart"
	},
	{
		title: "Wildlife & Woolly Art",
		desc: "I setup the shop and website for a Suffolk artist.",
		coverImage: "https://wildlifeandwoollyart.co.uk/images/artwork/painted_hare.webp",
		link: "https://wildlifeandwoollyart.co.uk",
		article: "/projects/wildlifeandwoollyart"
	},
	{
		title: "Wildlife & Woolly Art",
		desc: "I setup the shop and website for a Suffolk artist.",
		coverImage: "https://wildlifeandwoollyart.co.uk/images/artwork/painted_hare.webp",
		link: "https://wildlifeandwoollyart.co.uk",
		article: "/projects/wildlifeandwoollyart"
	},
	{
		title: "Wildlife & Woolly Art",
		desc: "I setup the shop and website for a Suffolk artist.",
		coverImage: "https://wildlifeandwoollyart.co.uk/images/artwork/painted_hare.webp",
		link: "https://wildlifeandwoollyart.co.uk",
		article: "/projects/wildlifeandwoollyart"
	},
	{
		title: "Wildlife & Woolly Art",
		desc: "I setup the shop and website for a Suffolk artist.",
		coverImage: "https://wildlifeandwoollyart.co.uk/images/artwork/painted_hare.webp",
		link: "https://wildlifeandwoollyart.co.uk",
		article: "/projects/wildlifeandwoollyart"
	}
]
---

<MainLayout>
	<GradientSection className="h-[600px] pt-20 p-2 lg:px-10 flex flex-col md:flex-row overflow-hidden">
		<div class="order-3 md:order-1 flex flex-col-reverse h-full">
			<div>
				<div class="flex">
					<ProfilePhoto src="https://avatars.githubusercontent.com/u/147245351?s=96" size="96" className="mr-2"></ProfilePhoto>
					<div class="md:hidden">
						<div class="flex flex-row items-start gap-3">
							<h1 class="font-display text-2xl sm:text-3xl text-white pt-1">Hi, I'm</h1>
							<h1 class="font-display text-2xl sm:text-5xl text-white pt-1">Oliver</h1>
						</div>
						<p class="font-display text-white"><IconBriefcase className="inline"></IconBriefcase> BSc Computer Sci. student</p>
						<p class="font-display text-white"><IconMapPin className="inline"></IconMapPin> Cambridge, UK</p>
					</div>

					<div>
						<h1 class="hidden md:block font-display text-white md:pt-1">Hi, I'm</h1>
						<p class="hidden md:block font-display text-5xl text-white">Oliver</p>
					</div>
				</div>
				
				
				<div class="hidden md:block md:grid grid-cols-1 md:grid-cols-2 grid-cols-row-1 md:grid-row-2 gap-5 overflow-hidden">
					<p class="font-display text-white"><IconBriefcase className="inline"></IconBriefcase> BSc Computer Science student</p>
					<p class="font-display text-white"><IconMapPin className="inline"></IconMapPin> Cambridge, UK</p>
				</div>
			</div>
		</div>

		<div class="order-2 hidden xl:block xl:grow"></div>

		<div class="order-1 md:order-3 justify-self-end grow flex-col-reverse">
			<MediaBox className="h-[360px] md:h-[480px] w-[640px] justify-self-center">
				<iframe class="w-full h-full" src="https://www.youtube.com/embed/CpCC2fTn0os?si=0DEHAeeGAR5nC2ME&start=6955&autoplay=1&controls=0&showinfo=0&autohide=1" title="Twemima Robot" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
			</MediaBox>
			<p class="text-white pt-2 text-right">Our team HRS robot at Student Robotics 2024!<IconArrowNarrowUp className="inline"></IconArrowNarrowUp></p>
		</div>
	</GradientSection>

	<div class="w-full bg-[#0d0730] text-white py-8">
		<h1 class="font-display text-center text-white">My Projects</h1>
		<p class="text-center pt-2">Take a look at the projects and work I've completed!</p>
		<div class="mx-2 md:mx-10 my-5">
			<div class="flex">
				<div class="hidden md:flex flex-col mr-2">
					<div class="grow"></div>
					<Button variant="outline" size="icon" className="dark" data-proj-scroll-left>
						<IconArrowNarrowLeft></IconArrowNarrowLeft>
					</Button>
					<div class="grow"></div>
				</div>

				<div id="project-gallery" class="flex overflow-y-scroll scrollbar-hide gap-1 scroll-smooth fade-x-4" data-proj-gallery>
					{projects.map((project) => (
						<ProjectCard
							title={project.title}
							desc={project.desc}
							coverImage={project.coverImage}
							link={project.link}
							article={project.article}>
						</ProjectCard>
					))}
				</div>

				<div class="hidden md:flex flex-col ml-2">
					<div class="grow"></div>
					<Button variant="outline" size="icon" className="dark" data-proj-scroll-right>
						<IconArrowNarrowRight></IconArrowNarrowRight>
					</Button>
					<div class="grow"></div>
				</div>
			</div>
		</div>
		<div class="flex ">
			<div class="grow" />
			<div>
				<Button variant="outline" size="icon" className="dark md:hidden" data-proj-scroll-left>
					<IconArrowNarrowLeft></IconArrowNarrowLeft>
				</Button>
				<Button data-view-all-btn>
					View all
				</Button>
				<Button variant="outline" size="icon" className="dark md:hidden" data-proj-scroll-right>
					<IconArrowNarrowRight></IconArrowNarrowRight>
				</Button>

			</div>
			<div class="grow" />
		</div>
	</div>

	</MainLayout>

<script>
// Find our component DOM on the page.
const rightScroll = document.querySelectorAll('[data-proj-scroll-right]');
const leftScroll = document.querySelectorAll('[data-proj-scroll-left]');
const viewAll = document.querySelector('[data-view-all-btn]');
const projects = document.getElementById("project-gallery");

function projScroll(right: boolean) {
	if (right) {
		projects.scrollLeft += 250;
	} else {
		projects.scrollLeft -= 250;
	}
}

rightScroll.forEach((btn) => {
	btn.addEventListener("click", function() {projScroll(true)})
})
leftScroll.forEach((btn) => {
	btn.addEventListener("click", function() {projScroll(false)})
})
viewAll?.addEventListener("click", function() {window.location.href = '/projects'})
</script>