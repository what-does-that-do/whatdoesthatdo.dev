---
import '@/styles/global.css';

import MainLayout from "@/layouts/mainLayout.astro";
import GradientSection from '@/components/ui/gradientSection.astro';
import ProjectCardHorizontal from '@/components/ui/projectCardHorizontal.astro';
import ProjectCard from '@/components/ui/projectCard.astro';

import { IconShovel } from '@tabler/icons-react';

const projects = Object.values(import.meta.glob(["./projects/*.md", "./projects/*.mdx"], {eager: true}))

// TODO: Add language badges as well as dates and locations,
// properly style project pages (maybe with prose)?
---
<MainLayout title="Projects by Oliver Corrigan">
    <GradientSection className="dark h-[175px] pt-22 p-2 lg:px-10 overflow-hidden text-white">
        <h1 class="font-display text-center">My Projects</h1>
        <p class="text-center pt-2">Please take a look at a few of my projects below!</p>
    </GradientSection>
    
    <div class="px-2 md:px-10 dark">
        <div>
            {projects.map((project: any) => (
                <ProjectCardHorizontal
                    title={project.frontmatter.title}
                    desc={project.frontmatter.desc}
                    coverImage={project.frontmatter.coverImage}
                    link={project.frontmatter.link}
                    article={project.url}
                    languages={project.frontmatter.languages}
                    openButton={project.frontmatter.openButton}>
                </ProjectCardHorizontal>
            ))}
        </div>
    </div>
    <div class="text-center py-5 px-4">
        <h1 class="text-gray-400 font-display">
            <IconShovel className="inline" size={64} stroke={2}></IconShovel>
            <br>
            That's not all!
        </h1>
        <p>I'm working on a few projects that aren't quite finished yet.</p>
        <p>The documentation is still in progress...</p>
        <p>Watch this space!</p>
    </div>
</MainLayout>