---
import '@/styles/global.css';
import MainLayout from './mainLayout.astro';
import GradientSection from '@/components/ui/gradientSection.astro';
import MediaBox from '@/components/ui/mediaBox.astro';
import Prose from './Prose.astro';
import LanguageBadges from '@/components/ui/languageBadges.astro';

import { buttonVariants } from '@/components/ui/button';

import { IconArrowBackUp, IconExternalLink } from '@tabler/icons-react';

const { frontmatter } = Astro.props;
---

<MainLayout title={frontmatter.title + " - whatdoesthatdo.dev"}>
    <GradientSection className="pt-20 md:h-[600px]">
        <div class="flex flex-col md:flex-row">
            <div class="order-2 md:order-1 grow flex flex-col w-full text-white text-center">
                <div class="hidden md:block">
                    <a
                        href="/projects"
                        class={buttonVariants({ variant: "outline" }) + " bg-transparent btn border-1 border-white mt-2 float-left"}
                    >
                        <IconArrowBackUp stroke={2} /> All Projects
                    </a>
                </div>
                <div class="grow" />
                <div>
                    <h1 class="font-display ">{frontmatter.title}</h1>
                    <p>{frontmatter.desc}</p>
                    <LanguageBadges languages={frontmatter.languages} />
                    { frontmatter.openButton != "hidden" &&
                    <a
                        href={frontmatter.link}
                        target="_blank"
                        class={buttonVariants({ variant: "outline" }) + " bg-transparent btn border-1 border-white mt-2"}
                    >
                        <IconExternalLink stroke={2} /> { frontmatter.openButton || "View" }
                    </a>}
                </div>
            </div>
            <div class="order-1 md:order-2 rounded-2xl shadow-lg overflow-hidden w-full h-[300px] md:h-[510px] shrink flex flex-col">
                <img src={frontmatter.coverImage} class="w-full object-cover object-center shrink">
            </div>
        </div>
    </GradientSection>

    <div class="flex pb-5">
        <div class="grow"></div>
        <div class="dark mx-2 pt-5">
            <Prose>
                <slot />
            </Prose>
        </div>
        <div class="grow"></div>
    </div>
</MainLayout>