---
import './src/styles/global.css';
import HeaderLink from './headerLink.astro';
import MobileNav from './mobileNav.astro';
---
<div class="fixed top-0 left-0 w-full px-4 py-2 bg-transparent">
    <div class="w-full h-16 flex bg-bg-light/60 dark:bg-bg-dark/60 rounded-xl p-3 backdrop-blur-md">
        <div class="opacity-100 flex items-center justify-between">
            <div id="hamburger" class="mt-[-48px]">
                <svg onclick="toggleMobNav()" width="48" height="48" class="light:hidden right-0 absolute mr-4 pointer md:hidden black">
                    <line x1="4" y1="8" x2="44" y2="8" stroke="white" stroke-width="2" />
                    <line x1="4" y1="24" x2="44" y2="24" stroke="white" stroke-width="2" />
                    <line x1="4" y1="40" x2="44" y2="40" stroke="white" stroke-width="2" />
                </svg>
                <svg onclick="toggleMobNav()" width="48" height="48" class="dark:hidden right-0 absolute mr-4 pointer md:hidden black">
                    <line x1="4" y1="8" x2="44" y2="8" stroke="black" stroke-width="2" />
                    <line x1="4" y1="24" x2="44" y2="24" stroke="black" stroke-width="2" />
                    <line x1="4" y1="40" x2="44" y2="40" stroke="black" stroke-width="2" />
                </svg>
            </div>
            
            <div id="downArrow" class="hidden mt-[-48px]">
                <svg onclick="toggleMobNav()" width="48" height="48" class="light:hidden right-0 absolute mr-4 pointer md:hidden black">
                    <line x1="4" y1="8" x2="22" y2="44" stroke="white" stroke-width="2" />
                    <line x1="22" y1="44" x2="44" y2="8" stroke="white" stroke-width="2" />
                </svg>
                <svg onclick="toggleMobNav()" width="48" height="48" class="dark:hidden right-0 absolute mr-4 pointer md:hidden black">
                    <line x1="4" y1="8" x2="22" y2="44" stroke="black" stroke-width="2" />
                    <line x1="22" y1="44" x2="44" y2="8" stroke="black" stroke-width="2" />
                </svg>
            </div>

            <h1 class="font-display">Oli</h1>
            <div class="md:block hidden">
                <HeaderLink href="/">Home</HeaderLink>
                <HeaderLink href="/about">About</HeaderLink>
                <HeaderLink href="/projects">Projects</HeaderLink>
                <HeaderLink href="/contact">Contact</HeaderLink>
            </div>
        </div>
    </div>
</div>

<div id="mobileNav" class="hidden">
    <MobileNav id="navbox" />
</div>

<script>
    const mobileNav = document.getElementById('mobileNav');
    const navbox = document.getElementById('navbox');
    const hamburger = document.getElementById('hamburger');
    const downArrow = document.getElementById('downArrow');

    window.toggleMobNav = function () {
        if (mobileNav.classList.contains('hidden')) {
            mobileNav.classList.remove('hidden');
            hamburger.classList.add('hidden');
            downArrow.classList.remove('hidden');

            navbox.animate([
                { transform: 'translateY(100%)' },
                { transform: 'translateY(0)' }
            ], {
                duration: 300,
                fill: 'forwards',
                easing: 'ease-in-out'
            });
        } else {
            downArrow.classList.add('hidden');
            hamburger.classList.remove('hidden');

            navbox.animate([
                { transform: 'translateY(0)' },
                { transform: 'translateY(100%)' }
            ], {
                duration: 300,
                fill: 'forwards',
                easing: 'ease-in-out'
            });
            setTimeout(() => {
                mobileNav.classList.add('hidden');
            }, 300);
        }
    }
</script>