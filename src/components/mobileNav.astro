---
import './src/styles/global.css';
import HeaderLink from './headerLink.astro';
const { id } = Astro.props;
---
<div id={id} class="fixed bottom-0 left-0 w-full px-4 py-2 bg-transparent">
    <div class="w-full bg-bg-light/60 dark:bg-bg-dark/60 rounded-xl p-3 backdrop-blur-md">
        <div class="opacity-100 items-center">
            <h1 class="font-display">Oli</h1>
            <HeaderLink href="/">Home</HeaderLink><br>
            <HeaderLink href="/about">About</HeaderLink><br>
            <HeaderLink href="/projects">Projects</HeaderLink><br>
            <HeaderLink href="/contact">Contact</HeaderLink>
        </div>
    </div>
</div>