---
import './src/styles/global.css';
const { href } = Astro.props;
const isCurrentPage = !(Astro.url?.pathname === href);
---
<a
  href={href}
  class={`font-link ml-4 text-3xl hover:text-primary hover:text-4xl transition-scale duration-200 ${
    isCurrentPage ? 'text-text-light dark:text-text-dark' : 'text-green-700'
  }`}
>
  <slot />
</a>